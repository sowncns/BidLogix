# Java API container
SERVER_PORT=8080
PREFIX_API=/api/v1
APP_PORT=8081

# Java PostgreSQL service in docker-compose. Restored from qs_crm backup.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=backend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password_123

# Host-published ports. Backend still connects inside compose to postgres:5432 and redis:6379.
DB_PORT=5434
REDIS_PORT=6380

DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
JPA_SHOW_SQL=false
HIBERNATE_DDL_AUTO=validate
FLYWAY_ENABLED=true

# Redis runs from this compose file.
REDIS_PASSWORD=redis_password_123

# Storage/public URLs
STORAGE_UPLOAD_DIR=/app/uploads
APP_PUBLIC_BASE_URL=http://host.docker.internal:8081/api/v1

# Auth
JWT_SECRET=change-this-secret-in-production-change-to-32chars-min
JWT_ACCESS_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=2592000000

# Mail/provider defaults: mock/noop unless real credentials are filled.
MAIL_ENABLED=false
MAIL_FROM=noreply@qs-crm.local

ZALO_ENABLED=false
ZALO_ACCESS_TOKEN=
ZALO_TEMPLATE_ID=
ZALO_API_URL=https://business.openapi.zalo.me/message/template

WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=otp_login
WHATSAPP_TEMPLATE_LANG=vi
WHATSAPP_API_URL=https://graph.facebook.com/v19.0

# Real messaging senders added in Java parity pass.
APP_MESSAGING_ZALO_ENABLED=false
APP_MESSAGING_WHATSAPP_ENABLED=false

# OnlyOffice: same values as Go when local OnlyOffice is running on host port 8082.
APP_ONLYOFFICE_DOC_SERVER_URL=http://localhost:8082
APP_ONLYOFFICE_INTERNAL_URL=http://host.docker.internal:8082
APP_ONLYOFFICE_JWT_SECRET=
