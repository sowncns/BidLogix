# Server Config
SERVER_PORT=8080
PREFIX_API=/api/v1

# Database PostgreSQL Config
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backend_db
DB_USERNAME=postgres
DB_PASSWORD=change_me
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# Redis / Redisson Config
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me

# JPA & Flyway Config
JPA_SHOW_SQL=false
HIBERNATE_DDL_AUTO=validate
FLYWAY_ENABLED=true

# Storage Config
STORAGE_UPLOAD_DIR=uploads

# Auth / JWT Config
JWT_SECRET=change-this-secret-to-a-long-random-string-min-32-chars
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Email (SMTP) Config - leave MAIL_ENABLED=false to just log emails instead of sending
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@example.com

# Zalo OA Config - leave ZALO_ENABLED=false to skip phone OTP fan-out via Zalo
ZALO_ENABLED=false
ZALO_ACCESS_TOKEN=
ZALO_TEMPLATE_ID=
ZALO_API_URL=https://business.openapi.zalo.me/message/template

# WhatsApp Cloud API Config - leave WHATSAPP_ENABLED=false to skip phone OTP fan-out via WhatsApp
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=vi
WHATSAPP_API_URL=https://graph.facebook.com/v19.0
